{
  "name": "focusly",
  "productName": "Focusly",
  "version": "1.0.12",
  "description": "Focusly — a simple, minimal time tracker for client work",
  "main": "src/main.js",
  "author": {
    "name": "Focusly",
    "email": "KateGrr@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.focusly.desktop",
    "productName": "Focusly",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Focusly",
      "artifactName": "Focusly-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "src/icons/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Focusly-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KateGrr",
        "repo": "focusly",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "Focusly ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icons/icon.png",
      "category": "Utility",
      "artifactName": "Focusly-${version}-linux-${arch}.${ext}",
      "synopsis": "Simple time tracker for client work"
    }
  },
  "homepage": "https://github.com/KateGrr/focusly",
  "repository": {
    "type": "git",
    "url": "https://github.com/KateGrr/focusly.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "keywords": [
    "time tracker",
    "time tracking",
    "client work",
    "productivity",
    "electron"
  ]
}
